#!/bin/sh
# 提交前只检查本次实际生效的作者和提交者身份。

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$HOOK_DIR/email-gate.sh"

author_ident=$(git var GIT_AUTHOR_IDENT 2>/dev/null) || email_gate_fail "无法解析当前作者身份。"
committer_ident=$(git var GIT_COMMITTER_IDENT 2>/dev/null) || email_gate_fail "无法解析当前提交者身份。"
email_gate_check_email "当前作者邮箱" "$(email_gate_email_from_ident "$author_ident")"
email_gate_check_email "当前提交者邮箱" "$(email_gate_email_from_ident "$committer_ident")"

exit 0
