{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "travel-guide-builder-v2 Trip Data",
  "description": "trip-data.json schema (v2.0) — single source of truth for rendering travel guide HTML.",
  "type": "object",
  "$defs": {
    "sourcedImage": {
      "type": "object", "additionalProperties": false,
      "required": ["src", "alt", "sourceId"],
      "properties": {
        "src": { "type": "string", "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(?:jpg|jpeg|png|webp)$" },
        "alt": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sourceId": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "required": [
    "schemaVersion",
    "stage",
    "meta",
    "features",
    "places",
    "route",
    "days",
    "transport",
    "budget",
    "recommendations",
    "localKnowledge",
    "checklist",
    "bookingLedger",
    "weather",
    "researchAudit",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "stage": {
      "enum": ["request", "brief", "content"]
    },
    "requirements": {
      "description": "Present only in request/brief stage.",
      "type": "object",
      "properties": {
        "mustVisit": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "preferences": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "openQuestions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "researchPlan": {
      "description": "Present only in request/brief stage.",
      "type": "object",
      "properties": {
        "xiaohongshuTarget": { "type": "integer", "minimum": 0 },
        "arrivalDepartureTarget": { "type": "integer", "minimum": 0 },
        "officialTopics": { "type": "array", "items": { "type": "string" } }
      }
    },
    "route": {
      "description": "Brief stage has route.summary/stops; content stage has stopIds/legs.",
      "oneOf": [
        {
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "stops": {
              "type": "array",
              "items": { "oneOf": [{ "type": "string" }, { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }] },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "stopIds": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "legs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["fromPlaceId", "toPlaceId", "mode", "duration"],
                "properties": {
                  "fromPlaceId": { "type": "string" },
                  "toPlaceId": { "type": "string" },
                  "mode": { "type": "string", "minLength": 1 },
                  "duration": { "type": "string", "minLength": 1 },
                  "sourceIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "dayOutline": {
      "description": "Brief stage day outline.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["dayNumber", "date", "city", "theme"],
        "properties": {
          "dayNumber": { "type": "integer" },
          "date": { "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }, { "type": "string", "pattern": "^$" }] },
          "city": { "type": "string", "minLength": 1 },
          "theme": { "type": "string", "minLength": 1 }
        }
      }
    },
    "researchSources": {
      "description": "Brief stage research sources.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "title"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "type": { "enum": ["xiaohongshu", "official", "local", "other"] },
          "url": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["general", "arrival-departure"] },
          "topics": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "cities": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "researchAudit": {
      "type": "object",
      "required": ["status", "xiaohongshuRequiredCount", "xiaohongshuReadCount", "xiaohongshuShortfallReason", "arrivalDepartureRequiredCount", "arrivalDepartureReadCount", "arrivalDepartureShortfallReason"],
      "properties": {
        "status": { "enum": ["pending", "completed", "blocked"] },
        "xiaohongshuRequiredCount": { "type": "integer" },
        "xiaohongshuReadCount": { "type": "integer" },
        "xiaohongshuShortfallReason": { "type": "string" },
        "arrivalDepartureRequiredCount": { "type": "integer" },
        "arrivalDepartureReadCount": { "type": "integer" },
        "arrivalDepartureShortfallReason": { "type": "string" },
        "decisionCoverage": { "type": "array", "items": { "type": "object", "required": ["topic", "status", "sourceIds"], "properties": { "topic": { "type": "string" }, "status": { "enum": ["verified", "pending"] }, "sourceIds": { "type": "array", "items": { "type": "integer" } } } } }
      }
    },
    "confirmation": {
      "description": "Brief stage confirmation of dayOutline.",
      "type": "object",
      "required": ["status", "note"],
      "properties": {
        "status": { "enum": ["pending", "confirmed", "skipped"] },
        "note": { "type": "string" }
      }
    },
    "meta": {
      "type": "object",
      "required": ["title", "destination", "origin", "datePolicy", "budgetBasis"],
      "properties": {
        "cultureNote": { "type": "string" },
        "guideId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,80}$", "description": "Stable identity, retained across title/date changes." },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "destination": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "minLength": 1 },
        "datePolicy": { "enum": ["fixed", "explicit", "season", "undated"] },
        "dates": {
          "type": "array",
          "items": { "type": "string", "format": "date" },
          "uniqueItems": true
        },
        "dateExclusions": {
          "type": "array",
          "description": "明确日期资料中存在、但经用户确认不纳入逐日攻略的日期。用于让航班等跨日记录可审计地通过日期覆盖门禁。",
          "items": {
            "type": "object",
            "required": ["date", "scope", "reason"],
            "additionalProperties": false,
            "properties": {
              "date": { "type": "string", "format": "date" },
              "scope": { "enum": ["arrival", "departure", "transfer", "other"] },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "dateDisplay": { "type": "string" },
        "travelers": {
          "type": "object",
          "required": ["count"],
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "profiles": { "type": "array", "items": { "type": "string" } }
          }
        },
        "budgetBasis": { "type": "string", "minLength": 1 },
        "theme": { "enum": ["rainforest", "coast", "terracotta", "ink", "burgundy", "midnight"], "description": "可选整页语义配色，省略时默认 coast；可根据封面主色、目的地气质与内容明度关系调整，不在组件内写死颜色。" },
        "hero": {
          "type": "object",
          "description": "图片封面首屏：只呈现固定英文眉题、原创标题与路线摘要；不定义行程事实或目的地短评字段。",
          "required": ["title", "subtitle", "cover"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "minLength": 2, "maxLength": 16, "description": "独立于攻略全名的原创编辑短标题；中文攻略优先四个汉字。" },
            "subtitle": { "type": "string", "minLength": 12, "maxLength": 100, "description": "按真实行程顺序压缩起点、关键过渡与收束点的一句话路线摘要。" },
            "kicker": { "type": "string", "minLength": 1, "maxLength": 48, "description": "旧数据兼容字段；当前模板固定显示 ITINERARY，不采用此值。" },
            "cover": {
              "type": "object",
              "required": ["src", "alt"],
              "additionalProperties": false,
              "properties": {
                "src": { "type": "string", "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(?:jpg|jpeg|png|webp)$" },
                "alt": { "type": "string", "minLength": 1, "maxLength": 160 }
              }
            },
            "showLinks": { "type": "boolean" },
            "budgetLabel": { "type": "string", "minLength": 1, "maxLength": 24 },
            "stages": {
              "type": "array", "minItems": 1, "maxItems": 6,
              "items": {
                "type": "object", "required": ["label", "summary", "dayNumbers"],
                "properties": {
                  "label": { "type": "string", "minLength": 1, "maxLength": 16 },
                  "summary": { "type": "string", "minLength": 1, "maxLength": 48 },
                  "dayNumbers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } }
                }
              }
            }
          }
        },
        "highlights": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 24 }
        },
        "routeSummary": { "type": "string" }
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "arrivalDeparture": { "type": "boolean" },
        "exchange": { "type": "boolean" },
        "weather": { "type": "boolean" },
        "sourceIndex": { "type": "boolean" },
        "dayMap": { "type": "boolean" },
        "contextualExplore": { "type": "boolean", "description": "按逐日 A→B 路段展示经研究的周边推荐；不在网页运行时生成未经核实的新地点。" },
        "nearbyExplore": { "type": "boolean", "description": "逐日附近逛逛：普通日 3–5 处、真正交通日 1–3 处；合理不显示日为 0 并记录原因。道路可缺段。旧版无状态记录保持兼容。" },
        "dayNavigation": { "type": "boolean" },
        "calendarExport": { "type": "boolean" },
        "expenseTracker": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "calendar": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["daily", "timed"] }
      }
    },
    "arrivalDeparture": {
      "type": "object",
      "nullable": true,
      "properties": {
        "airportKits": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["arrivalIndex", "airport", "nextStop", "cards"],
            "properties": {
              "arrivalIndex": { "type": "integer", "minimum": 0 },
              "airport": { "type": "string", "minLength": 1 },
              "nextStop": { "type": "string", "minLength": 1 },
              "cards": {
                "type": "array", "minItems": 1, "maxItems": 3,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["kind", "lead", "facts"],
                  "properties": {
                    "kind": { "enum": ["sim", "exchange", "transport"] },
                    "lead": { "type": "string", "minLength": 1 },
                    "condition": { "type": "string", "minLength": 1 },
                    "details": { "type": "string", "minLength": 1 },
                    "facts": {
                      "type": "array", "minItems": 1,
                      "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["label", "value", "sourceIds"],
                        "properties": {
                          "label": { "type": "string", "minLength": 1 },
                          "value": { "type": "string", "minLength": 1 },
                          "observedAt": { "type": "string", "format": "date" },
                          "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "apps": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "name", "region", "logoSrc", "purpose", "sourceIds"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "region": { "type": "string", "minLength": 1 },
              "logoSrc": { "type": "string", "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(?:jpg|jpeg|png|webp)$" },
              "purpose": { "type": "string", "minLength": 1 },
              "notice": { "type": "string", "minLength": 1 },
              "officialUrl": { "type": "string", "pattern": "^https://" },
              "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }
            }
          }
        },
        "forms": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["direction", "name", "appliesTo", "submission", "fields", "sourceIds"],
            "properties": {
              "direction": { "enum": ["arrival", "departure"] },
              "name": { "type": "string", "minLength": 1 },
              "appliesTo": { "type": "string", "minLength": 1 },
              "submission": { "type": "string", "minLength": 1 },
              "officialUrl": { "type": "string", "pattern": "^https://" },
              "fields": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["label", "guidance"],
                  "properties": {
                    "label": { "type": "string", "minLength": 1 },
                    "guidance": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }
            }
          }
        },
        "experiences": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["direction", "airport", "observedAt", "sourceIds"],
            "properties": {
              "direction": { "enum": ["arrival", "departure"] },
              "airport": { "type": "string", "minLength": 1 },
              "terminal": { "type": "string" },
              "arrivalWindow": { "type": "string" },
              "visaType": { "type": "string" },
              "observedAt": { "type": "string", "format": "date" },
              "queueMinutes": { "type": "integer", "minimum": 0 },
              "landingToExitMinutes": { "type": "integer", "minimum": 0 },
              "detail": { "type": "string" },
              "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }
            }
          }
        },
        "arrival": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["when", "action"],
            "properties": {
              "when": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "riskAlternative": { "type": "string", "minLength": 1 },
              "sourceIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
            }
          }
        },
        "departure": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["when", "action"],
            "properties": {
              "when": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "riskAlternative": { "type": "string", "minLength": 1 },
              "sourceIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
            }
          }
        },
        "flights": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "legLabel": { "enum": ["去程", "返程"] },
              "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 2880 },
              "connection": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "airportCode": { "type": "string", "pattern": "^[A-Z]{3}$" },
                  "airport": { "type": "string", "minLength": 1, "maxLength": 80 },
                  "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 10080 }
                }
              },
              "seat": { "type": "string", "pattern": "^[A-Z0-9 -]{1,12}$" },
              "gate": { "type": "string", "pattern": "^[A-Z0-9 -]{1,12}$" },
              "baggageClaim": { "type": "string", "pattern": "^[A-Z0-9 -]{1,12}$" },
              "flightNumber": { "type": "string", "pattern": "^[A-Z0-9]{2}[0-9]{3,4}$" },
              "airline": { "type": "string", "minLength": 1 },
              "departureDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "departureTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
              "arrivalDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "arrivalTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
              "departureCode": { "type": "string", "minLength": 1 },
              "departureAirport": { "type": "string", "minLength": 1 },
              "departureTerminal": { "type": "string" },
              "arrivalCode": { "type": "string", "minLength": 1 },
              "arrivalAirport": { "type": "string", "minLength": 1 },
              "arrivalTerminal": { "type": "string" },
              "detailUrl": { "type": "string", "pattern": "^https://" }
            }
          }
        }
      }
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "localName", "searchName", "city", "country", "coordinates", "verificationStatus"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "localName": { "type": "string", "minLength": 1 },
          "searchName": { "type": "string", "minLength": 1 },
          "usage": { "enum": ["itinerary", "suggestion"] },
          "navigationEnabled": { "type": "boolean" },
          "city": { "type": "string", "minLength": 1 },
          "country": { "type": "string", "minLength": 1 },
          "coordinates": {
            "type": "object",
            "nullable": true,
            "required": ["latitude", "longitude"],
            "properties": {
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
            }
          },
          "verificationStatus": { "type": "string", "minLength": 1 },
          "sourceIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dayNumber", "date", "city", "theme", "kind", "intensity", "accommodation", "items", "sourceIds"],
        "properties": {
          "dayNumber": { "type": "integer" },
          "routeNote": { "type": "string", "minLength": 1 },
          "routeNoteAvatar": { "type": "string", "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(?:jpg|jpeg|png|webp)$" },
          "date": { "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }, { "type": "string", "pattern": "^$" }] },
          "city": { "type": "string", "minLength": 1 },
          "theme": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["arrival", "city", "daytrip", "transfer", "mountain", "flex", "departure"], "nullable": true },
          "intensity": {
            "type": "object",
            "required": ["score"],
            "properties": {
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 5,
                "multipleOf": 0.5
              }
            }
          },
          "accommodation": {
            "type": "object",
            "required": ["label", "startPlaceId", "endPlaceId", "status"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "startPlaceId": { "type": "string" },
              "endPlaceId": { "type": "string" },
              "status": { "enum": ["stay", "checkin", "checkout", "transfer", "none"] },
              "note": { "type": "string", "minLength": 1 }
            }
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "allOf": [
                { "not": { "required": ["navigationMode", "navigationOptions"] } }
              ],
              "required": ["id", "type", "placeId", "title", "activity", "details", "links", "calendarHighlight", "startTime", "endTime", "timeText", "transportMode", "travelMinutes", "stayMinutes", "breakGroundRoute", "reservationStatus", "sourceIds"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "enum": ["place", "transport", "reservation", "note"] },
                "placeId": { "type": "string" },
                "title": { "type": "string", "minLength": 1 },
                "activity": { "type": "string", "minLength": 1 },
                "details": { "type": "array", "items": { "type": "string" } },
                "notes": { "type": "array", "items": { "type": "string" } },
                "links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["label", "url"],
                    "properties": {
                      "label": { "type": "string", "minLength": 1 },
                      "url": { "type": "string", "format": "uri" }
                    }
                  }
                },
                "referenceImages": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["src", "title", "alt", "caption"],
                    "properties": {
                      "src": { "type": "string", "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(?:jpg|jpeg|png|webp)$" },
                      "title": { "type": "string", "minLength": 1, "maxLength": 40 },
                      "alt": { "type": "string", "minLength": 1, "maxLength": 160 },
                      "caption": { "type": "string", "minLength": 1, "maxLength": 120 }
                    }
                  }
                },
                "calendarHighlight": { "type": "boolean" },
                "startTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
                "endTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
                "timeText": { "type": "string", "maxLength": 24 },
                "transportMode": { "type": "string", "minLength": 1 },
                "navigationMode": { "description": "单一路线偏好；与 navigationOptions 互斥", "enum": ["driving", "motorcycle", "tuktuk", "walking", "transit", "bus", "ferry", "cablecar", "mountainrail", "tram", "monorail", "minibus", "rickshaw", "bicycling"] },
                "navigationOptions": {
                  "description": "多方案对比；与 navigationMode 互斥，推荐项耗时必须等于 travelMinutes",
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 5,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["mode", "durationMinutes", "recommended"],
                    "properties": {
                      "mode": { "enum": ["driving", "motorcycle", "tuktuk", "walking", "transit", "bus", "ferry", "cablecar", "mountainrail", "tram", "monorail", "minibus", "rickshaw", "bicycling"] },
                      "durationMinutes": { "type": "integer", "minimum": 1 },
                      "recommended": { "type": "boolean" }
                    }
                  }
                },
                "travelMinutes": { "type": "integer", "minimum": 0 },
                "stayMinutes": { "type": "integer", "minimum": 0 },
                "breakGroundRoute": { "type": "boolean" },
                "reservationStatus": { "enum": ["none", "pending", "confirmed", "verify"] },
                "sourceIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
              }
            }
          },
          "food": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "calendarNotes": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
          "sourceIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "transport": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to", "departureWindow", "arrivalWindow", "mode", "duration", "cost"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "departureWindow": { "type": "string", "minLength": 1 },
          "arrivalWindow": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "minLength": 1 },
          "duration": { "type": "string", "minLength": 1 },
          "cost": { "type": "string", "minLength": 1 },
          "verification": { "type": "string", "minLength": 1 },
          "sourceIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["baseCurrency", "targetCurrencies", "items", "total"],
      "properties": {
        "exchangeChannels": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "name", "kind", "currency", "observedAt", "sourceIds"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["atm", "counter", "bank"] },
              "placeId": { "type": "string", "minLength": 1 },
              "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
              "observedAt": { "type": "string", "format": "date" },
              "rateLocalPerCny": { "type": "number", "exclusiveMinimum": 0 },
              "feeCny": { "type": "number", "minimum": 0 },
              "feePercent": { "type": "number", "minimum": 0, "maximum": 100 },
              "feeLocal": { "type": "number", "minimum": 0 },
              "condition": { "type": "string" },
              "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }
            }
          }
        },
        "baseCurrency": { "const": "CNY" },
        "targetCurrencies": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{3}$" } },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "min", "max", "currency", "note"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "min": { "type": "number", "minimum": 0 },
              "max": { "type": "number", "minimum": 0 },
              "currency": { "const": "CNY" },
              "note": { "type": "string" },
              "sourceIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
            }
          }
        },
        "total": {
          "type": "object",
          "required": ["min", "max", "currency"],
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 },
            "currency": { "const": "CNY" }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "name", "reason", "travelerFit", "timing", "routeRelation", "duration", "reservation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "enum": ["景点指南", "当地体验", "餐饮指南"] },
          "name": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "travelerFit": { "type": "string", "minLength": 1 },
          "timing": { "type": "string", "minLength": 1 },
          "routeRelation": { "type": "string", "minLength": 1 },
          "duration": { "type": "string", "minLength": 1 },
          "reservation": { "type": "string", "minLength": 1 },
          "limit": { "type": "string", "minLength": 1 },
          "executionAdvice": { "type": "string", "minLength": 1 },
          "placeId": { "type": "string", "minLength": 1 },
          "officialUrl": { "type": "string", "pattern": "^https://" },
          "image": { "$ref": "#/$defs/sourcedImage" },
          "productPicks": { "type": "array", "items": { "type": "object", "required": ["name", "reason", "image", "sourceIds"], "properties": { "name": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "where": { "type": "string" }, "priceObserved": { "type": "string" }, "image": { "$ref": "#/$defs/sourcedImage" }, "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } } } } },
          "menuItems": { "type": "array", "items": { "type": "object", "required": ["name", "reason", "sourceIds"], "properties": { "name": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "priceObserved": { "type": "string" }, "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } } } } },
          "sourceIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "recommendationPlacements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "dayNumber", "anchorItemId", "slot", "entries"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "dayNumber": { "type": "integer", "minimum": 1 },
          "anchorItemId": { "type": "string", "minLength": 1 },
          "slot": { "enum": ["en_route", "lunch", "coffee", "experience", "flexible"] },
          "entries": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "object", "required": ["targetType", "targetId", "routeRelation"], "properties": { "targetType": { "enum": ["venueSuggestion", "recommendation"] }, "targetId": { "type": "string", "minLength": 1 }, "routeRelation": { "enum": ["on_route", "nearby", "minor_detour", "detour"] }, "note": { "type": "string" } } } }
        }
      }
    },
    "explorationSegments": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false,
        "required": ["id", "dayNumber", "fromPlaceId", "toPlaceId", "candidates"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "dayNumber": { "type": "integer", "minimum": 1 },
          "fromPlaceId": { "type": "string", "minLength": 1 },
          "toPlaceId": { "type": "string", "minLength": 1 },
          "candidates": { "type": "array", "minItems": 1, "maxItems": 5,
            "items": { "type": "object", "additionalProperties": false,
              "required": ["targetType", "targetId", "relation"],
              "properties": {
                "targetType": { "enum": ["recommendation", "venueSuggestion"] },
                "targetId": { "type": "string", "minLength": 1 },
                "relation": { "enum": ["near_start", "near_end", "near_route", "detour"] },
                "detourMinutes": { "type": "integer", "minimum": 0 },
                "sourceIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
              }
            }
          }
        }
      }
    },
    "nearbyDays": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false,
        "required": ["dayNumber", "candidates"],
        "properties": {
          "dayNumber": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["show", "hide-late-arrival", "hide-early-departure", "hide-no-free-window", "research-pending"] },
          "dayType": { "enum": ["ordinary", "transit"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
          "readyAt": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "leaveAt": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "freeWindows": { "type": "array", "description": "可为空的已核实净自由窗口，仅作安排参考，不作为候选显示资格。", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["startTime", "endTime", "city", "anchorPlaceId", "bufferMinutes", "basis"],
            "properties": {
              "startTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
              "endTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
              "city": { "type": "string", "minLength": 1 },
              "anchorPlaceId": { "type": "string", "minLength": 1 },
              "bufferMinutes": { "type": "integer", "minimum": 0 },
              "basis": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          } },
          "candidates": { "type": "array", "minItems": 0, "maxItems": 10,
            "items": { "type": "object", "additionalProperties": false,
              "required": ["targetType", "targetId", "whyNow"],
              "properties": {
                "targetType": { "enum": ["recommendation", "venueSuggestion"] },
                "targetId": { "type": "string", "minLength": 1 },
                "whyNow": { "type": "string", "minLength": 1, "maxLength": 160, "description": "推荐价值与用户兴趣的具体依据，不限顺路地点。" },
                "windowIndex": { "type": "integer", "minimum": 0, "description": "可省略；填写时必须引用当天真实窗口，不用于限制推荐资格。" },
                "timing": { "type": "string", "minLength": 1, "maxLength": 160, "description": "安排提示，按需说明营业、预约或调整条件，不承诺能塞进原行程。" },
                "area": { "type": "string", "maxLength": 80, "description": "可选位置/交通关系，有依据时说明顺路可去或需专程前往。" }
              }
            }
          }
        }
      }
    },
    "dayRoadRoutes": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false,
        "required": ["dayNumber", "legs"],
        "properties": {
          "dayNumber": { "type": "integer", "minimum": 1 },
          "legs": { "type": "array",
            "items": { "type": "object", "additionalProperties": false,
              "required": ["fromPlaceId", "toPlaceId", "encodedPolyline", "provider"],
              "properties": {
                "fromPlaceId": { "type": "string", "minLength": 1 },
                "toPlaceId": { "type": "string", "minLength": 1 },
                "encodedPolyline": { "type": "string", "minLength": 8, "maxLength": 100000 },
                "provider": { "enum": ["google-routes", "baidu-routes", "verified-road"] },
                "observedAt": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "recommendationNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "text"],
        "properties": {
          "category": { "enum": ["景点指南", "当地体验", "餐饮指南"] },
          "text": { "type": "string", "minLength": 1 },
          "sourceIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "localKnowledge": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["id", "category", "title", "guidance", "dayNumbers", "placeIds", "sourceIds"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "enum": ["文化特点", "会客礼仪", "文化禁忌"] },
          "title": { "type": "string", "minLength": 1 },
          "guidance": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "dayNumbers": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
          "placeIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "sourceIds": { "type": "array", "items": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "sourceIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "venueSuggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "placeId", "reason", "timing", "bookingPolicy", "officialUrl", "checkedAt", "sourceIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["cafe", "shop", "restaurant"] },
          "placeId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "timing": { "type": "string", "minLength": 1 },
          "bookingPolicy": { "enum": ["not_required", "recommended", "required", "verify"] },
          "bookingNote": { "type": "string" },
          "officialUrl": { "type": "string", "format": "uri" },
          "checkedAt": { "type": "string", "format": "date" },
          "image": { "$ref": "#/$defs/sourcedImage" },
          "menuItems": { "type": "array", "items": { "type": "object", "required": ["name", "reason", "sourceIds"], "properties": { "name": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "priceObserved": { "type": "string" }, "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } } } } },
          "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "bookingLedger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "title", "when", "participants", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "enum": ["activity", "restaurant"] },
          "title": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "participants": { "type": "string", "minLength": 1 },
          "status": { "enum": ["confirmed", "pending", "verify"] },
          "placeId": { "type": "string" },
          "bookingUrl": { "type": "string", "format": "uri" },
          "sourceIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "weather": {
      "type": "object",
      "required": ["enabled", "startDate", "endDate", "locations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "placeId", "latitude", "longitude"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "placeId": { "type": "string" },
              "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
              "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "title", "url", "scope", "topics", "cities", "verificationStatus"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "type": { "enum": ["xiaohongshu", "official", "local", "other"] },
          "url": { "type": "string", "format": "uri" },
          "scope": { "enum": ["general", "arrival-departure"], "default": "general" },
          "title": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1 },
          "topics": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "cities": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "verificationStatus": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourceIndex": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "title", "cities", "tags", "searchHints"],
        "properties": {
          "sourceId": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "cities": { "type": "array", "items": { "type": "string" } },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "searchHints": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
